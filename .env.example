# mini-harness 的环境变量参考清单。
# 本项目会**自动读取** .env(优先级:命令行参数 > 已存在的环境变量 > .env > 内置默认值),
# 所以这份文件只是对照用的模板,不改名成 .env 也能跑。

# ---- 模型接口(默认接 DashScope / 阿里云百炼的 OpenAI 兼容模式)----

# 必填:API key。也认 DEEPSEEK_API_KEY / OPENAI_API_KEY
DASHSCOPE_API_KEY=sk-your-key-here

# 可选:端点。默认 https://dashscope.aliyuncs.com/compatible-mode/v1
# 换成自建网关/代理写它自己的地址即可,末尾带不带 /v1 都能识别:
#   https://maas.example.com/compatible-mode/v1 -> .../compatible-mode/v1/chat/completions
#   https://api.openai.com/v1                   -> .../v1/chat/completions
#   https://api.deepseek.com                    -> .../v1/chat/completions
#   http://127.0.0.1:8000                       -> .../v1/chat/completions
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选:模型名。默认 qwen-plus(官方 DashScope 命名)。
# 各家网关命名不同;MaaS 类代理上常见 qwen3.7-plus / qwen3.7-flash / qwen3.7-max
# / deepseek-v4.1-flash / deepseek-v4-pro / glm-5.3 / kimi-k3。
DASHSCOPE_MODEL=qwen-plus

# 可选：配置后 web_search 优先使用 Tavily Search API；失败或结果不足时回退网页搜索。
# 使用 basic 深度，不请求 AI 答案或原始全文；请求消耗 Tavily 搜索额度。
TAVILY_API_KEY=

# ---- 运行参数 ----

# 单个 turn 的最大 step 数(默认 8)
MINI_HARNESS_MAX_STEPS=64

# 流式输出(默认 1 = 开)。设 0 = 等整段返回再打印
MINI_HARNESS_STREAMING=1

# 边流边执行(默认 1 = 开):工具参数一补全就派发,不等模型把话说完。设 0 = 关闭
MINI_HARNESS_EARLY_TOOLS=1

# 权限预设：read-only / workspace-write（默认）/ danger-full-access
MINI_HARNESS_PERMISSION_MODE=workspace-write
# Windows 首次运行：python scripts/setup_sandbox.py
# 可选：指定工作区外的 Node 沙箱运行时目录
# MINI_HARNESS_SANDBOX_RUNTIME_ROOT=C:/Users/your-user/.mini-harness/sandbox-runtime

# 工具结果外溢(默认 1):超预算就落盘 + 返回路径,而不是截断丢弃
MINI_HARNESS_SPILL=1
# 外溢目录(默认 ~/.mini-harness/spill);会话级子目录 + 随机文件名
# MINI_HARNESS_SPILL_ROOT=D:/tmp/spill
# 超过多少字符算"太大"(默认 12000)。要注意它必须大于头尾之和,否则会被按比例缩
MINI_HARNESS_SPILL_INLINE_CHARS=12000

# 上下文压缩(默认 1):投影裁剪工具结果 + 把最老的一段压成摘要
MINI_HARNESS_COMPACTION=1
# 0 关闭独立历史上限（窗口自动压缩仍启用）；正数仅限制 messages，不含 system/schema
MINI_HARNESS_MAX_HISTORY_TOKENS=0
# 0 = 按 token 保留；正数显式切换为最近 N 条消息下限
MINI_HARNESS_KEEP_RECENT=0
MINI_HARNESS_COMPACTION_THRESHOLD_RATIO=0.8
MINI_HARNESS_COMPACTION_RETAIN_RATIO=0.16
# 以下仅预留压缩预算，不设置服务商 max_tokens
MINI_HARNESS_COMPACTION_HEADROOM_TOKENS=0
MINI_HARNESS_COMPACTION_RESERVED_COMPLETION_TOKENS=0

# 上下文窗口大小(显示和自动压缩共用)。显式配置优先，其次读取服务商容量，最后用近似表。
# MINI_HARNESS_CONTEXT_WINDOW=131072

# 模型调用失败时的重试(默认开)。429/5xx/连接抖动才会重试;400/401/403 不重试
MINI_HARNESS_RETRY_ATTEMPTS=3
# 无限重试,直到成功或取消(对应 dsh 的 always 模式)
MINI_HARNESS_RETRY_ALWAYS=0
# 指数退避的基数秒数(1→2→4…,上限 8 秒;带 25% 抖动)
MINI_HARNESS_RETRY_BASE_DELAY=0.5

# 子代理(默认开):给模型一个 task 工具用来委派隔离子代理
MINI_HARNESS_SUBAGENTS=1
# 允许的嵌套深度(默认 1 = 只派一层;深度用 ContextVar 记,将来并行派发也安全)
MINI_HARNESS_SUBAGENT_DEPTH=1

# 单次模型请求超时秒数(默认 120;思考型模型偶尔偏慢)
MINI_HARNESS_TIMEOUT=120

# 单条 shell 命令超时秒数(默认 60)
MINI_HARNESS_SHELL_TIMEOUT=60

# 指定 shell:bash / pwsh / powershell / cmd 或完整路径。
# 不设就自动选:Windows 上优先找**原生 Git Bash**,并绕开指向 WSL 的
# %LOCALAPPDATA%\Microsoft\WindowsApps\bash.EXE 别名(选中它会让你所有命令
# 跑进 Linux 子系统,PATH 和 python 都不是 Windows 的)。
# 实测启动成本:bash ≈ 60ms、cmd ≈ 85ms、powershell ≈ 406ms、pwsh ≈ 630ms
# —— 非必要别换成 pwsh。
# MINI_HARNESS_SHELL=bash

# 覆盖系统人格提示
# MINI_HARNESS_PERSONA=You are a terse shell assistant.

# 指定 .env 位置(指到一个不存在的路径 = 关掉自动读取)
# MINI_HARNESS_ENV_FILE=E:/path/to/.env
